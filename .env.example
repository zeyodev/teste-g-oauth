# zkeys — cofre de credenciais + proxy de integrações (DESIGN-zkeys.md §12)

PORT=5000

# URL pública: redirect_uri dos providers = ${OAUTH_PUBLIC_BASE_URL}/auth/<name>/callback
# (deve casar com o cadastrado no painel de cada provider)
OAUTH_PUBLIC_BASE_URL=https://zkeys.metaorg.app

# ── Segredos (todos: openssl rand -hex 32; NUNCA no banco/repo) ──────────
# KEK da cifra at-rest AES-256-GCM dos tokens (32 bytes hex)
ZKEYS_MASTER_KEY=
# Pepper do Argon2id (trocar invalida TODOS os hashes de senha)
ZKEYS_AUTH_PEPPER=
# Assinatura do cookie de sessão (JWT HS256)
ZKEYS_SESSION_SECRET=

# ── Opcionais ────────────────────────────────────────────────────────────
# Path do SQLite (default: ./data/zkeys.db)
# ZKEYS_DB_PATH=
# Dir dos providers/*.json (default: ./providers)
# ZKEYS_PROVIDERS_DIR=
# Só dev em http: emite cookies sem Secure
# ZKEYS_INSECURE_COOKIE=1

# ── Rede / rate limit (F4, §9) ───────────────────────────────────────────
# Atrás do cloud-proxy/tunnel, o IP real vem do X-Forwarded-For. Valor do
# app.set("trust proxy", …): número de hops confiáveis (default 1 = o tunnel),
# "true"/"false" ou "loopback". Cadeia mais profunda → aumentar o número.
# ZKEYS_TRUST_PROXY=1
# Rate limit do login (anti-brute-force): teto por IP e por email, por janela.
# ZKEYS_RL_LOGIN_MAX=10
# ZKEYS_RL_LOGIN_WINDOW_S=300
# Rate limit do proxy /p/* (anti-abuso): teto por IP e por token id, por janela.
# ZKEYS_RL_PROXY_MAX=600
# ZKEYS_RL_PROXY_WINDOW_S=60

# ── Providers (client_id_env/client_secret_env dos providers/*.json) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=
# config_id de uma Configuration do Facebook Login for Business (pertence ao app
# do META_APP_ID). Vazio = login clássico por scope (sem config_id na URL).
META_APP_CONFIG=

# Instagram API com login do Instagram — app SEPARADO do META_* (que é p/ Ads).
# "ID do app do Instagram" + "Chave secreta do app do Instagram" no painel.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Verify token do webhook (você INVENTA: openssl rand -hex 24). Cole o MESMO
# valor no campo "Verificar token" do painel. Sem isto o handshake GET dá 500.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Cloud API — app SEPARADO (não é o META_* dos Ads nem o INSTAGRAM_*).
# App ID + App Secret do app do WhatsApp (Configurações > Básico do app).
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Verify token do webhook (você INVENTA: openssl rand -hex 24). Mesmo valor no
# campo "Verificar token" do painel do WhatsApp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

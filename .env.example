# Porta do servidor OAuth
PORT=5000

# URL pública pra onde os redirects do provider vão (deve casar com o que está
# registrado no painel do provider). OAuth2Provider monta callbackUrl como
# `${OAUTH_PUBLIC_BASE_URL}/auth/${name}/callback`.
OAUTH_PUBLIC_BASE_URL=https://oauth.metaorg.app

# Segredo compartilhado com o metaorg/backend. Server-to-server pra:
#  - POST /api/oauth/callback (oauth/ → backend, após troca code→tokens)
#  - POST /refresh/:provider, POST /revoke/:provider (backend → oauth/)
# Gerar: openssl rand -hex 32
OAUTH_BACKEND_TOKEN=

# URL interna do metaorg/backend pra postar o callback.
METAORG_BACKEND_URL=http://localhost:8080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Facebook/Instagram) OAuth
META_APP_ID=
META_APP_SECRET=

# Canva OAuth
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

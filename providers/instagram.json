{
  "name": "instagram",
  "displayName": "Instagram (Unified Login)",
  "icon": "instagram.svg",
  "authorize_url": "https://www.facebook.com/v23.0/dialog/oauth",
  "token_url": "https://graph.facebook.com/v23.0/oauth/access_token",
  "revoke_url": "https://graph.facebook.com/v23.0/me/permissions",
  "revoke_method": "DELETE",
  "api_base_url": "https://graph.facebook.com/v23.0",
  "auth_injection": { "kind": "query", "param": "access_token" },
  "sign": "appsecret_proof",
  "pkce": false,
  "auth_token_in_header": false,
  "client_id_env": "INSTAGRAM_APP_ID",
  "client_secret_env": "INSTAGRAM_APP_SECRET",
  "webhook_verify_token_env": "INSTAGRAM_WEBHOOK_VERIFY_TOKEN",
  "authorize_extra_env": {
    "config_id": "INSTAGRAM_APP_CONFIG"
  },
  "account_discovery": { "kind": "unified_instagram" },
  "packs": {
    "manage": {
      "label": "Gerenciar Instagram",
      "description": "DM, comentários, publicação e insights (Unified Login: config_id dirige as permissões; scopes abaixo são fallback/catálogo).",
      "scopes": [
        "instagram_basic",
        "instagram_manage_messages",
        "instagram_manage_comments",
        "instagram_content_publish",
        "instagram_manage_insights"
      ]
    }
  },
  "extensions": ["graph_webhook", "meta_signed_request"]
}
